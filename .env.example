# Copy to .env and adjust.

# Local: Postgres.app, PostgreSQL 18, port 5432. Postgres.app creates a role named
# after your macOS user with no password. Create the database with:
#   /Applications/Postgres.app/Contents/Versions/18/bin/createdb afterword
DATABASE_URL=postgres://YOUR_MAC_USERNAME@localhost:5432/afterword

# Auth is a single-account bypass until real auth lands (#4). Every request is this
# author, created on first request if missing. Not safe to expose publicly on its own;
# see #7 for putting it behind Caddy basic auth.
DEV_AUTHOR_EMAIL=owner@afterword.local
DEV_AUTHOR_NAME=Owner
